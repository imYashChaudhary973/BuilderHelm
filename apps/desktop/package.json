{
  "name": "@zero/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/xterm": "5.5.0",
    "@zero/core": "workspace:*",
    "@zero/protocol": "workspace:*",
    "@zero/shared": "workspace:*",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty.mjs",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "smoke": "node scripts/smoke.mjs",
    "baseline:pty": "HELM_PTY_BASELINE=1 vitest run --root ../.. apps/desktop/test/pty-baseline.test.ts",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json --pretty false"
  },
  "build": {
    "appId": "app.builderhelm.desktop",
    "productName": "BuilderHelm",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/**",
      "**/@napi-rs/keyring/**"
    ],
    "files": [
      "out"
    ],
    "electronVersion": "39.8.10",
    "electronDist": "../../node_modules/electron/dist",
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.icns",
      "identity": null
    }
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
