{
  "name": "builderhelm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "pnpm --filter @builderhelm/desktop build",
    "dev": "pnpm --filter @builderhelm/desktop dev",
    "dist": "pnpm --filter @builderhelm/desktop dist",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:telemetry": "node scripts/check-telemetry.mjs",
    "notices": "pnpm --filter @builderhelm/desktop notices",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:migrations": "vitest run packages/db/test/migrations.test.ts",
    "smoke:desktop": "pnpm --filter @builderhelm/desktop smoke",
    "verify": "pnpm check:architecture && pnpm check:licenses && pnpm check:telemetry && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "43.4.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
