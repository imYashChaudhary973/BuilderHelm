#!/bin/sh
# New feature worktree from origin/main. Does not touch main.
# usage: scripts/worktree-add <name>
set -eu
name=${1:-}
if [ -z "$name" ]; then
  echo "usage: $0 <name>" >&2
  exit 1
fi
common=$(git rev-parse --path-format=absolute --git-common-dir)
repo=$(dirname "$common")
dest="$(dirname "$repo")/$(basename "$repo")-worktrees/$name"
git fetch origin
git worktree add -b "feat/$name" "$dest" origin/main
printf '%s\n' "$dest"
